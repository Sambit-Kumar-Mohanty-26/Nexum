{
  "name": "nexum-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Nexum Express API and Prisma PostgreSQL persistence layer",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "test": "vitest run --testTimeout=20000",
    "verify:phase0": "tsx --env-file=.env tests/verify-phase0.ts",
    "verify:phase1": "tsx --env-file=.env tests/verify-phase1.ts",
    "verify:phase2": "tsx --env-file=.env tests/verify-phase2.ts",
    "verify:phase3": "tsx --env-file=.env tests/verify-phase3.ts",
    "verify:phase4": "tsx --env-file=.env tests/verify-phase4.ts",
    "verify:phase5": "tsx --env-file=.env tests/verify-phase5.ts",
    "verify:phase6": "tsx --env-file=.env tests/verify-phase6.ts",
    "verify:phase7": "tsx --env-file=.env tests/verify-phase7.ts",
    "verify:phase8": "tsx --env-file=.env tests/verify-phase8.ts",
    "verify:batch6": "tsx --env-file=.env tests/verify-batch6.ts",
    "agreements:backfill": "tsx --env-file=.env src/scripts/backfillAgreements.ts"
  },
  "prisma": {
    "seed": "tsx --env-file=.env prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@google/genai": "^2.32.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.4.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.13.5",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.23.1",
    "@types/sharp": "^0.31.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^2.5.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "prisma": "^6.4.1",
    "sharp": "^0.35.5",
    "typescript": "^5.7.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "tsx": "^4.19.3",
    "vitest": "^3.0.7"
  }
}
