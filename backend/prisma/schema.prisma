generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  CLIENT
  FREELANCER
  OPERATOR
}

enum AvailabilityStatus {
  AVAILABLE
  LIMITED
  UNAVAILABLE
}

enum ProjectState {
  DRAFT
  INTAKE
  MATCHING
  NEGOTIATING
  ACTIVE
  COMPLETED
  CANCELLED
  DISPUTED
}

enum OpportunityStatus {
  INVITED
  ACCEPTED
  DECLINED
  EXPIRED
}

enum AudienceType {
  PRIVATE
  SHARED
}

enum PRDStatus {
  DRAFT
  SHARED
  ACCEPTED
  SUPERSEDED
}

enum ProposalStatus {
  DRAFT
  SUBMITTED
  COUNTERED
  ACCEPTED
  REJECTED
  EXPIRED
}

enum PaymentState {
  NOT_STARTED
  CREATED
  APPROVED
  CAPTURE_PENDING
  CAPTURED
  DENIED
  APPROVAL_REVERSED
  UNKNOWN
  NEEDS_SUPPORT
  REFUNDED
  PARTIALLY_REFUNDED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum ReconciliationStatus {
  SCHEDULED
  PROCESSING
  RESOLVED
  FAILED
  ESCALATED
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  CANCELLED
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DisputeStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum AIOutputStatus {
  DRAFT
  APPROVED
  REJECTED
}

enum LedgerType {
  FUNDED
  RELEASE_RECORDED_SIMULATED
  REFUNDED
}

// ---------------------------------------------------------------------------
// Core Identity & Profile
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  role      Role
  email     String   @unique
  name      String
  locale    String   @default("en-US")
  timezone  String   @default("UTC")
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  freelancerProfile    FreelancerProfile?
  clientProjects       Project[]             @relation("ClientProjects")
  proposals            ProposalVersion[]     @relation("FreelancerProposals")
  approvals            Approval[]
  messages             ConversationMessage[]
  disputesOpened       DisputeHold[]         @relation("DisputeOpener")
  opportunities        Opportunity[]
  assistantConversations AssistantConversation[]
}

model FreelancerProfile {
  id                    String             @id @default(cuid())
  userId                String             @unique
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                 String
  bio                   String
  skills                String[]
  portfolio             Json               @default("[]")
  experienceClaims      Json               @default("[]")
  ratePreferences       Json               @default("{}")
  availability          AvailabilityStatus @default(AVAILABLE)
  availabilityUpdatedAt DateTime           @default(now())
  verificationFlags     Json               @default("{}")
  isDemoData            Boolean            @default(false)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
}

// ---------------------------------------------------------------------------
// Projects, Briefs & Opportunities
// ---------------------------------------------------------------------------

model Project {
  id          String       @id @default(cuid())
  clientId    String
  client      User         @relation("ClientProjects", fields: [clientId], references: [id], onDelete: Restrict)
  title       String
  description String
  state       ProjectState @default(DRAFT)
  goals       String       @default("")
  budgetCents Int          @default(0) // Integer minor units (USD cents)
  currency    String       @default("USD")
  deadline    DateTime?
  visibility  String       @default("INVITE_ONLY")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  briefVersions ProjectBriefVersion[]
  prdVersions   PRDVersion[]
  proposals     ProposalVersion[]
  opportunities Opportunity[]
  messages      ConversationMessage[]
  changeRequests ChangeRequest[]
}

model ProjectBriefVersion {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version         Int
  structuredBrief Json
  contentHash     String
  status          String   @default("CURRENT")
  createdAt       DateTime @default(now())

  @@unique([projectId, version])
}

model Opportunity {
  id                    String            @id @default(cuid())
  projectId             String
  project               Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  freelancerId          String
  freelancer            User              @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  invitedBriefVersionId String?
  status                OpportunityStatus @default(INVITED)
  responseNotes         String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@unique([projectId, freelancerId])
}

model ConversationMessage {
  id                 String       @id @default(cuid())
  projectId          String
  project            Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorId            String
  actor              User         @relation(fields: [actorId], references: [id], onDelete: Restrict)
  audience           AudienceType @default(SHARED)
  content            String
  intent             String?
  relatedVersionHash String?
  createdAt          DateTime     @default(now())

  @@index([projectId, createdAt])
}

// ---------------------------------------------------------------------------
// PRD & Agreement Version Chain
// ---------------------------------------------------------------------------

model PRDVersion {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version       Int
  requirements  Json // Array of requirement objects with stable REQ-xxx IDs
  assumptions   Json      @default("[]")
  openQuestions Json      @default("[]")
  status        PRDStatus @default(DRAFT)
  createdAt     DateTime  @default(now())

  @@unique([projectId, version])
}

model ProposalVersion {
  id              String         @id @default(cuid())
  projectId       String
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  freelancerId    String
  freelancer      User           @relation("FreelancerProposals", fields: [freelancerId], references: [id], onDelete: Restrict)
  version         Int
  parentVersionId String?
  parentVersion   ProposalVersion? @relation("ProposalHistory", fields: [parentVersionId], references: [id])
  childVersions   ProposalVersion[] @relation("ProposalHistory")
  versionHash     String         @unique // SHA-256 canonical hash
  scope           String
  exclusions      Json           @default("[]")
  amountCents     Int            // Integer minor units (USD cents)
  currency        String         @default("USD")
  milestonesJson  Json           @default("[]")
  assumptions     Json           @default("[]")
  expiresAt       DateTime?
  status          ProposalStatus @default(DRAFT)
  createdAt       DateTime       @default(now())

  milestones Milestone[]

  @@unique([projectId, version])
}

model Milestone {
  id                String       @id @default(cuid())
  proposalVersionId String
  proposalVersion   ProposalVersion @relation(fields: [proposalVersionId], references: [id], onDelete: Cascade)
  orderIndex        Int
  title             String
  deliverables      Json         @default("[]")
  criteria          Json         @default("[]")
  amountCents       Int          // Minor unit cents
  currency          String       @default("USD")
  state             PaymentState @default(NOT_STARTED)
  fundingRule       String       @default("PRE_FUNDED_BEFORE_WORK")
  deadline          DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  paymentAttempts PaymentAttempt[]
  ledgerEntries   LedgerEntry[]
  disputeHolds    DisputeHold[]

  @@unique([proposalVersionId, orderIndex])
}

model Approval {
  id          String           @id @default(cuid())
  actorId     String
  actor       User             @relation(fields: [actorId], references: [id], onDelete: Restrict)
  objectType  String           // e.g. "PROPOSAL", "PRD", "DELIVERABLE"
  objectId    String
  versionHash String           // Canonical hash approved
  decision    ApprovalDecision
  comments    String?
  timestamp   DateTime         @default(now())

  @@index([objectId, versionHash])
}

// ---------------------------------------------------------------------------
// Payment Execution, Webhooks & Fault Recovery
// ---------------------------------------------------------------------------

model PaymentAttempt {
  id                String       @id @default(cuid())
  milestoneId       String
  milestone         Milestone    @relation(fields: [milestoneId], references: [id], onDelete: Restrict)
  provider          String       @default("PAYPAL")
  environment       String       @default("SANDBOX")
  orderId           String?
  captureId         String?
  amountCents       Int
  currency          String       @default("USD")
  state             PaymentState @default(CREATED)
  idempotencyKey    String       @unique
  uncertaintyReason String?
  returnedFeeCents  Int?
  returnedNetCents  Int?
  evidencePayload   Json?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  reconciliationJobs ReconciliationJob[]
  paymentIncidents   PaymentIncident[]

  @@index([orderId])
  @@index([captureId])
}

model WebhookEvent {
  id               String   @id @default(cuid())
  providerEventId  String   @unique // PayPal WH-... event id (strictly deduped)
  type             String   // e.g. PAYMENT.CAPTURE.COMPLETED
  providerTimestamp DateTime
  signatureResult  String   // SUCCESS, FAILURE, SKIPPED
  processingResult String   @default("PENDING") // PROCESSED, DUPLICATE, IGNORED, ERROR
  rawPayload       Json
  createdAt        DateTime @default(now())

  @@index([type, providerTimestamp])
}

model ReconciliationJob {
  id               String               @id @default(cuid())
  paymentAttemptId String
  paymentAttempt   PaymentAttempt       @relation(fields: [paymentAttemptId], references: [id], onDelete: Cascade)
  scheduledAt      DateTime
  attemptCount     Int                  @default(0)
  maxAttempts      Int                  @default(5)
  status           ReconciliationStatus @default(SCHEDULED)
  result           String?
  evidenceRead     Json?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([status, scheduledAt])
}

model PaymentIncident {
  id                 String         @id @default(cuid())
  paymentAttemptId   String
  paymentAttempt     PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Cascade)
  incidentType       String         // e.g. TIMEOUT_AFTER_CAPTURE
  status             IncidentStatus @default(OPEN)
  openedAt           DateTime       @default(now())
  closedAt           DateTime?
  operatorDiagnostic String?
  userMessage        String         // OECD Paper 167 consumer protection explanation

  @@index([status, openedAt])
}

// ---------------------------------------------------------------------------
// Change Requests, Disputes & Safety
// ---------------------------------------------------------------------------

model ChangeRequest {
  id                 String              @id @default(cuid())
  projectId          String
  project            Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  baseVersionHash    String
  classification     String              // MINOR, MAJOR, CRITICAL
  confidence         Float
  differences        Json
  priceImpactCents   Int                 @default(0)
  scheduleImpactDays Int                 @default(0)
  status             ChangeRequestStatus @default(PENDING)
  createdAt          DateTime            @default(now())

  @@index([projectId, baseVersionHash])
}

model DisputeHold {
  id          String        @id @default(cuid())
  milestoneId String
  milestone   Milestone     @relation(fields: [milestoneId], references: [id], onDelete: Restrict)
  openedById  String
  openedBy    User          @relation("DisputeOpener", fields: [openedById], references: [id], onDelete: Restrict)
  reason      String
  evidence    Json          @default("[]")
  status      DisputeStatus @default(OPEN)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model AIOutput {
  id               String         @id @default(cuid())
  model            String
  promptVersion    String
  inputRecordIds   Json
  rawOutput        String
  parsedOutput     Json
  schemaResult     String         // PASS, FAIL
  validatorResults Json
  status           AIOutputStatus @default(DRAFT)
  createdAt        DateTime       @default(now())
}

model LedgerEntry {
  id             String     @id @default(cuid())
  milestoneId    String
  milestone      Milestone  @relation(fields: [milestoneId], references: [id], onDelete: Restrict)
  type           LedgerType
  amountCents    Int
  currency       String     @default("USD")
  sourceEvidence Json
  createdAt      DateTime   @default(now())

  @@index([milestoneId, type])
}

model AuditEvent {
  id          String   @id @default(cuid())
  actorId     String?
  action      String
  objectType  String
  objectId    String
  versionHash String?
  timestamp   DateTime @default(now())
  metadata    Json?

  @@index([objectType, objectId])
  @@index([timestamp])
}

// ---------------------------------------------------------------------------
// Nexum AI Persistent Conversation Workspace
// ---------------------------------------------------------------------------

model AssistantConversation {
  id                 String             @id @default(cuid())
  userId             String
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title              String
  messageCount       Int                @default(0)
  lastMessageSnippet String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  messages           AssistantMessage[]

  @@index([userId, updatedAt])
}

model AssistantMessage {
  id             String                @id @default(cuid())
  conversationId String
  conversation   AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String                // "user", "assistant", "system"
  content        String
  status         String                @default("sent")
  createdAt      DateTime              @default(now())

  @@index([conversationId, createdAt])
}

