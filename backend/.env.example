PORT=4000
NODE_ENV=development

# Database Connection (PostgreSQL / Neon DB)
# For local Docker: postgresql://proofloop:proofloop@localhost:5435/proofloop?schema=public
# For Neon Serverless Postgres: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require"

CORS_ORIGIN="http://localhost:3000"
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID="your_sandbox_client_id"
PAYPAL_CLIENT_SECRET="your_sandbox_client_secret"
PAYPAL_WEBHOOK_ID=""
APP_BASE_URL="http://localhost:3000"
ENABLE_FAULT_INJECTOR="true"
SESSION_SECRET="your_32_bytes_session_secret"
AI_DAILY_BUDGET="50"

# Google Gemini API for structured AI analysis and resume extraction
GEMINI_API_KEY=""

# Telegram Mobile Gateway
TELEGRAM_BOT_TOKEN=""

# Groq API (LLaMA 3.3 70B & Whisper Large v3 for Voice Notes)
GROQ_API_KEY=""

# EmailJS (for Mobile OTP Authentication & Email Notifications)
EMAILJS_SERVICE_ID=""
EMAILJS_TEMPLATE_ID=""
EMAILJS_PUBLIC_KEY=""
EMAILJS_PRIVATE_KEY=""

# 100% Free Open-Source Models ($0, No Credit Card Required):
# Option 1: OpenRouter (DeepSeek-R1 / Llama 3.3 70B :free models)
# Get a 100% free key at: https://openrouter.ai/keys (zero cost, select :free models)
OPENROUTER_API_KEY=""

# Option 2: GitHub Models ($0 free for any GitHub account, DeepSeek-R1 / Llama 3.3 70B)
# Get free token at: https://github.com/settings/tokens
GITHUB_TOKEN=""

# Option 3: Hugging Face Serverless API ($0 free tier, Qwen 2.5 72B)
# Get free token at: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=""

# Option 4: Direct DeepSeek API (Optional pay-as-you-go)
DEEPSEEK_API_KEY=""

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

# Microsoft OAuth 2.0 Credentials
# Register at: https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps/ApplicationsListBlade
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_CALLBACK_URL="http://localhost:3000/api/auth/microsoft/callback"

# GitHub OAuth 2.0 Credentials
# Register at: https://github.com/settings/developers
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="http://localhost:3000/api/auth/github/callback"
